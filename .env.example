# ============================================
# Django 環境變數配置範例
# ============================================
# 
# 使用說明：
# 1. 複製此文件為 .env（在同一個目錄下）
# 2. 填入下方各項目的實際值
# 3. 注意：.env 文件包含敏感信息，不會被提交到版本控制
#
# 複製命令（Windows PowerShell）：
#   Copy-Item .env.example .env
#
# 複製命令（Linux/Mac）：
#   cp .env.example .env
# ============================================

# ========== 安全設定 ==========
# SECRET_KEY: Django 的密鑰，用於加密 Session、CSRF Token 等
# 生成方式：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 生產環境必須更改此值！
SECRET_KEY=your-secret-key-here-change-this-in-production

# DEBUG: 是否開啟除錯模式
# 開發環境設為 True，生產環境必須設為 False
DEBUG=True

# ALLOWED_HOSTS: 允許訪問的主機列表（用逗號分隔）
# 開發環境：localhost,127.0.0.1
# 生產環境：your-domain.com,www.your-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# 部署環境：local（預設）或 production
DJANGO_ENV=local

# 對外網址（郵件連結用，不含 http://）
SITE_DOMAIN=localhost:8000

# ========== 資料庫設定 ==========
# 資料庫引擎：sqlite（地端開發，免安裝資料庫）或 mysql（生產環境）
DB_ENGINE=sqlite

# SQLite 檔案路徑（可省略，預設為專案根目錄的 db.sqlite3）
# SQLITE_NAME=db.sqlite3

# 以下設定僅在 DB_ENGINE=mysql 時使用
# 資料庫名稱
DB_NAME=goodjian

# 資料庫使用者名稱
DB_USER=root

# 資料庫密碼（重要：請填入實際密碼）
DB_PASSWORD=your-database-password

# 資料庫主機（本地開發通常是 localhost）
DB_HOST=localhost

# 資料庫連接埠（MySQL 預設為 3306）
DB_PORT=3306

# ========== 郵件設定（可選） ==========
# 如果需要使用郵件功能（如密碼重設、通知等），請填入以下資訊
# 如果暫時不需要，可以留空

# 郵件後端（通常不需要修改）
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP 伺服器地址（Gmail 使用 smtp.gmail.com）
EMAIL_HOST=smtp.gmail.com

# SMTP 連接埠（Gmail 使用 587）
EMAIL_PORT=587

# 是否使用 TLS（Gmail 必須設為 True）
EMAIL_USE_TLS=True

# 郵件帳號（發送郵件的帳號）
EMAIL_HOST_USER=your-email@gmail.com

# 郵件密碼（Gmail 需要使用「應用程式密碼」，不是一般密碼）
EMAIL_HOST_PASSWORD=your-email-password

# 預設發送者名稱和郵件
DEFAULT_FROM_EMAIL=好健健 GoodJian Plus <noreply@goodjianplus.com>

# ========== 社群登入（可選） ==========
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# ========== SMS / 手機登入（可選） ==========
SMS_TEST_MODE=True
SMS_PROVIDER=clicksend
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_FROM_NUMBER=

# ========== LINE Pay（可選） ==========
LINE_PAY_CHANNEL_ID=
LINE_PAY_CHANNEL_SECRET=
LINE_PAY_SANDBOX=True

# ========== 靜態文件和媒體文件 ==========
# 這些路徑通常會自動設置，一般不需要修改
# 只有在特殊部署環境下才需要手動設定

# STATIC_ROOT=/path/to/staticfiles
# MEDIA_ROOT=/path/to/media

# ========== 安全設定（生產環境） ==========
# 以下鍵僅作文件說明：實際安全開關由 DEBUG=False 時自動啟用，程式不會讀取這些變數。

# 是否強制使用 HTTPS（生產環境建議設為 True）
SECURE_SSL_REDIRECT=False

# Session Cookie 是否僅在 HTTPS 下傳輸
SESSION_COOKIE_SECURE=False

# CSRF Cookie 是否僅在 HTTPS 下傳輸
CSRF_COOKIE_SECURE=False

# 啟用瀏覽器 XSS 過濾
SECURE_BROWSER_XSS_FILTER=True

# 啟用內容類型嗅探保護
SECURE_CONTENT_TYPE_NOSNIFF=True

# 防止點擊劫持（設為 DENY 禁止在 iframe 中載入）
X_FRAME_OPTIONS=DENY

# ========== 日誌設定 ==========
# 日誌級別：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 日誌文件路徑（相對於專案根目錄）
LOG_FILE=logs/django.log

# ============================================
# 設定完成後，請執行以下命令測試：
#   python manage.py check
#
# 如果沒有錯誤，就可以啟動開發伺服器：
#   python manage.py runserver
# ============================================
